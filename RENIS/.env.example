# RENIS Environment Configuration Template
# Copy this file to .env and adjust variables as needed

# Network Binding
RENIS_HOST=0.0.0.0
RENIS_PORT=8765

# Security & Authentication
# If left empty, a secure random 256-bit key will be auto-generated and stored in renis_auth.json
RENIS_JWT_SECRET=
RENIS_JWT_ALGORITHM=HS256
RENIS_JWT_EXPIRE_HOURS=12

# Default initial Master PIN (6 digits). User will be prompted to change upon first login.
RENIS_DEFAULT_PIN=000000

# Wake-on-LAN Target Configuration (Optional default MAC address of the host machine)
RENIS_TARGET_MAC=00:00:00:00:00:00
RENIS_BROADCAST_IP=255.255.255.255
RENIS_WOL_PORT=9
